{
  "name": "yreview",
  "displayName": "Yreview",
  "description": "Review comments that live in git notes. The same comments show in the Yreview plugin for JetBrains IDEs.",
  "version": "0.0.0",
  "publisher": "yeskiy",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeskiy/yreview.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/yeskiy/yreview/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/yeskiy/yreview/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "code review",
    "review comments",
    "git notes",
    "git-appraise"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Yreview runs git, and git reads the repository configuration, which can name programs."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yreview.showLog",
        "title": "Show Log",
        "category": "Yreview"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prose": "node scripts/prose-check.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha",
    "test:integration": "node scripts/build.mjs --tests && node scripts/test-workspace.mjs && vscode-test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "dependencies": {
    "sqids": "0.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.5",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
