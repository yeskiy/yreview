<idea-plugin>
  <id>com.yeskiy.ideareview</id>
  <name>IDEA Review</name>
  <vendor>yeskiy</vendor>
  <description><![CDATA[
    Write review comments on any line, in the editor and in the diff.
    Comments are stored as git notes in the git-appraise format.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>
  <depends optional="true" config-file="idea-review-mcp.xml">com.intellij.mcpServer</depends>

  <extensions defaultExtensionNs="com.intellij">
    <diff.DiffExtension implementation="com.yeskiy.ideareview.diff.ReviewDiffExtension" />

    <intentionAction>
      <language />
      <className>com.yeskiy.ideareview.action.AddCommentIntention</className>
      <category>Review comments</category>
    </intentionAction>

    <codeInsight.lineMarkerProvider
        language=""
        implementationClass="com.yeskiy.ideareview.gutter.CommentGutterProvider" />

    <toolWindow id="Review Comments" anchor="bottom"
                factoryClass="com.yeskiy.ideareview.toolwindow.ReviewToolWindowFactory" />

    <projectConfigurable parentId="tools"
                         id="com.yeskiy.ideareview.settings"
                         displayName="Review Comments"
                         nonDefaultProject="true"
                         instance="com.yeskiy.ideareview.settings.ReviewConfigurable" />
  </extensions>

  <actions>
    <action id="com.yeskiy.ideareview.AddComment"
            class="com.yeskiy.ideareview.action.AddCommentAction"
            text="Add Review Comment"
            description="Write a review comment on the selected lines.">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action id="com.yeskiy.ideareview.AddDiffComment"
            class="com.yeskiy.ideareview.diff.AddDiffCommentAction"
            text="Add Review Comment"
            description="Write a review comment on the selected lines of this diff side.">
      <add-to-group group-id="Diff.EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
