<idea-plugin>
  <id>com.yeskiy.yreview</id>
  <name>Y Review</name>
  <vendor>yeskiy</vendor>
  <description><![CDATA[
    Write review comments on any line, in the editor and in the diff.
    Comments are stored as git notes in the git-appraise format.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>
  <depends optional="true" config-file="y-review-mcp.xml">com.intellij.mcpServer</depends>
  <depends optional="true" config-file="y-review-terminal.xml">org.jetbrains.plugins.terminal</depends>

  <dependencies>
    <module name="intellij.platform.collaborationTools" />
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <diff.DiffExtension implementation="com.yeskiy.yreview.diff.ReviewDiffExtension" />

    <intentionAction>
      <language />
      <className>com.yeskiy.yreview.action.AddCommentIntention</className>
      <category>Review comments</category>
      <skipBeforeAfter>true</skipBeforeAfter>
    </intentionAction>

    <editorFactoryListener implementation="com.yeskiy.yreview.gutter.CommentGutterListener" />

    <toolWindow id="Review Comments" anchor="bottom" icon="/icons/yReviewComments.svg"
                factoryClass="com.yeskiy.yreview.toolwindow.ReviewToolWindowFactory" />

    <notificationGroup id="Y Review" displayType="BALLOON" />

    <projectConfigurable parentId="tools"
                         id="com.yeskiy.yreview.settings"
                         displayName="Review Comments"
                         nonDefaultProject="true"
                         instance="com.yeskiy.yreview.settings.ReviewConfigurable" />
  </extensions>

  <actions>
    <action id="com.yeskiy.yreview.AddComment"
            class="com.yeskiy.yreview.action.AddCommentAction"
            text="Add Review Comment"
            description="Write a review comment on the selected lines.">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action id="com.yeskiy.yreview.AddDiffComment"
            class="com.yeskiy.yreview.diff.AddDiffCommentAction"
            text="Add Review Comment"
            description="Write a review comment on the selected lines of this diff side.">
      <add-to-group group-id="Diff.EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
