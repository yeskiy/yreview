{
  "name": "y-review-channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code channel server that pushes Y Review comments into an open session",
  "license": "MIT",
  "bin": {
    "y-review-channel": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20.19 --outfile=bundle/main.mjs",
    "start": "node dist/main.js",
    "fake-bridge": "node dist/fakeBridge.js",
    "test": "vitest run",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
